[Unit]
Description=Reconcile CWNG user data with Calibre library
After=calibre-server.service calibre-web-nextgen.service

[Service]
Type=oneshot
User=calibreweb
Group=calibreweb
ExecStart=/root/calibre/CalibreWeb/current/.venv/bin/python /root/calibre/CalibreWeb/current/deploy/maintenance/reconcile_app_db.py --app-db /root/calibre/CalibreWeb/var/config/app.db --library-db /root/calibre/Library/metadata.db --marker /root/calibre/CalibreWeb/var/run/reconcile.trigger
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/root/calibre/Library /root/calibre/CalibreWeb/source
ReadWritePaths=/root/calibre/CalibreWeb/var
