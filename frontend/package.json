{
  "name": "cwng-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test:unit": "tsc -p tsconfig.e2e.json --noEmit && node --experimental-strip-types --test unit/*.test.ts",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report e2e/.report"
  },
  "dependencies": {
    "@embedpdf/core": "^2.14.4",
    "@embedpdf/models": "^2.14.4",
    "@embedpdf/plugin-annotation": "^2.14.4",
    "@embedpdf/plugin-scroll": "^2.14.4",
    "@embedpdf/react-pdf-viewer": "^2.14.4",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@tanstack/react-query": "^5.59.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "wouter": "^3.3.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "epubjs": "^0.3.93",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.9.10"
  }
}
